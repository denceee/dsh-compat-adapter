{
  "name": "dsh-compat-adapter",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "前置/基座适配插件：把 Claude Code / Codex / WorkBuddy / OpenCode / GitHub Copilot 的 hooks 与 rules 通过显式声明适配到 DSH seam；覆盖 5 家 vendor、112 个事件，能力分级（DIRECT/ADAPTED/CARRY/UNSUPPORTED），每条适配都逐项列出损失，fail-closed。",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./matrix": {
      "types": "./index.d.ts",
      "default": "./src/matrix.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check-surface": "node scripts/check-surface.js",
    "matrix": "node scripts/write-matrix.js --print",
    "matrix:write": "node scripts/write-matrix.js",
    "test": "node --import ./test/helpers/register-dsh-resolver.js --test test/*.test.js",
    "verify:live": "node scripts/verify-live.mjs",
    "verify": "node scripts/check-surface.js && node --import ./test/helpers/register-dsh-resolver.js --test test/*.test.js && node scripts/verify-live.mjs",
    "verify:installed": "node scripts/verify-installed.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.0-rc.2",
    "@deepseek-ai/dsh-hooks-codex": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "scripts/",
    "locale/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "INTEGRATION.md"
  ],
  "types": "./index.d.ts",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "hooks",
    "rules",
    "adapter",
    "claude-code",
    "codex",
    "workbuddy",
    "codebuddy",
    "opencode",
    "github-copilot"
  ]
}
